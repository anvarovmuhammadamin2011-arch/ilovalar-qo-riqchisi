<?xml version="1.0" encoding="utf-8"?>
<!-- One onboarding page: illustration, title and a short text, all centered. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingTop="24dp"
    android:paddingBottom="48dp">

    <!-- A soft ring around a white circle; the icon sits in the middle. -->
    <FrameLayout
        android:id="@+id/illustration"
        android:layout_width="184dp"
        android:layout_height="184dp"
        android:background="@drawable/bg_curbox_circle"
        android:backgroundTint="@color/curbox_primary_container">

        <View
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:layout_gravity="center"
            android:alpha="0.55"
            android:background="@drawable/bg_curbox_circle"
            android:backgroundTint="@color/curbox_surface" />

        <!-- Plain white with a real shadow; a Material card would tint it toward the brand color. -->
        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_curbox_circle"
            android:backgroundTint="@color/curbox_surface"
            android:elevation="8dp"
            android:outlineProvider="background">

            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/curbox_primary" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_title"
        style="@style/TextAppearance.Curbox.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:maxWidth="340dp" />

    <TextView
        android:id="@+id/tv_body"
        style="@style/TextAppearance.Curbox.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:maxWidth="320dp"
        android:textColor="@color/curbox_text_secondary"
        android:textSize="16sp" />
</LinearLayout>
