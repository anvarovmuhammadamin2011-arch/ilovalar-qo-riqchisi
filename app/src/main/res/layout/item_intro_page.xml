<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_curbox_circle"
        android:backgroundTint="@color/curbox_primary_container">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/curbox_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_title"
        style="@style/TextAppearance.Curbox.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:accessibilityHeading="true"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_body"
        style="@style/TextAppearance.Curbox.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/curbox_space_l"
        android:gravity="center"
        android:textColor="@color/curbox_text_secondary" />
</LinearLayout>
