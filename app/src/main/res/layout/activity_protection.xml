<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/protection_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/protection_back"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:title="@string/protection_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/curbox_screen_padding"
            android:paddingBottom="@dimen/curbox_space_xl">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/curbox_space_s">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/curbox_screen_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/status_icon_bg"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_curbox_circle">

                            <ImageView
                                android:id="@+id/status_icon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_admin_shield" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_status_title"
                            style="@style/TextAppearance.Curbox.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/curbox_space_l"
                            android:layout_weight="1"
                            android:accessibilityHeading="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_status_body"
                        style="@style/TextAppearance.Curbox.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/curbox_space_m" />

                    <TextView
                        android:id="@+id/tv_progress"
                        style="@style/TextAppearance.Curbox.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/curbox_space_l" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/curbox_space_s"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/tv_last_sync"
                        style="@style/TextAppearance.Curbox.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/curbox_space_s" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_check"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/curbox_space_m"
                        android:text="@string/protection_check_again" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Curbox.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/curbox_space_xl"
                android:accessibilityHeading="true"
                android:text="@string/protection_section_permissions" />

            <TextView
                style="@style/TextAppearance.Curbox.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/curbox_space_xs"
                android:text="@string/protection_section_permissions_hint" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/curbox_space_m">

                <LinearLayout
                    android:id="@+id/list_checks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/curbox_space_xs" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Curbox.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/curbox_space_xl"
                android:accessibilityHeading="true"
                android:text="@string/protection_section_mode" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/curbox_space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/curbox_screen_padding">

                    <TextView
                        android:id="@+id/tv_mode_title"
                        style="@style/TextAppearance.Curbox.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tv_mode_body"
                        style="@style/TextAppearance.Curbox.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/curbox_space_xs" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mode_help"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/curbox_space_s"
                        android:layout_marginStart="-12dp"
                        android:text="@string/protection_mode_help" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/uninstall_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Curbox.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/curbox_space_xl"
                    android:accessibilityHeading="true"
                    android:text="@string/protection_section_uninstall" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/curbox_space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/curbox_screen_padding">

                        <TextView
                            android:id="@+id/tv_uninstall_state"
                            style="@style/TextAppearance.Curbox.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_uninstall"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/curbox_space_m"
                            android:text="@string/protection_uninstall_button" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/release_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Curbox.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/curbox_space_xl"
                    android:accessibilityHeading="true"
                    android:text="@string/protection_section_release" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/curbox_space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/curbox_screen_padding">

                        <TextView
                            style="@style/TextAppearance.Curbox.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/protection_release_body" />

                        <TextView
                            android:id="@+id/tv_release_state"
                            style="@style/TextAppearance.Curbox.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/curbox_space_s"
                            android:textColor="@color/curbox_warning_text"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_release"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/curbox_space_m"
                            android:text="@string/protection_release_button"
                            app:icon="@drawable/ic_admin_shield" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
