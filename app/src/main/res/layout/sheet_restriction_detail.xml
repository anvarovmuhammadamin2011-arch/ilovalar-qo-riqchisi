<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/curbox_screen_padding"
    android:paddingTop="@dimen/curbox_space_s"
    android:paddingBottom="@dimen/curbox_space_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tv_name"
            style="@style/TextAppearance.Curbox.Section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/curbox_space_m"
            android:layout_weight="1" />

        <neth.iecal.curbox.ui.components.StatusPill
            android:id="@+id/pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_reason"
        style="@style/TextAppearance.Curbox.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/curbox_space_l" />

    <TextView
        android:id="@+id/tv_limit"
        style="@style/TextAppearance.Curbox.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/curbox_space_s"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_schedule"
        style="@style/TextAppearance.Curbox.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/curbox_space_s"
        android:visibility="gone" />

    <TextView
        style="@style/TextAppearance.Curbox.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/curbox_space_l"
        android:text="@string/user_restrictions_read_only" />
</LinearLayout>
