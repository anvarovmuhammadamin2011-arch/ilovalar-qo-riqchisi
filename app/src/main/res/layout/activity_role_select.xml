<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/role_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/curbox_screen_padding"
        android:paddingTop="48dp"
        android:paddingBottom="@dimen/curbox_space_xl">

        <LinearLayout
            android:id="@+id/brand_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/logo" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Curbox.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/curbox_space_l"
                android:text="@string/app_name" />

            <TextView
                style="@style/TextAppearance.Curbox.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/splash_tagline" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/title_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Curbox.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/role_title" />

            <TextView
                style="@style/TextAppearance.Curbox.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/role_subtitle" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/curbox_space_l"
            android:clickable="true"
            android:focusable="true">

            <neth.iecal.curbox.ui.components.AppRowView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/curbox_space_l"
                app:rowIcon="@drawable/ic_admin_shield"
                app:rowIconInCircle="true"
                app:rowShowChevron="true"
                app:rowSubtitle="@string/role_admin_desc"
                app:rowTitle="@string/role_admin_title" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/curbox_card_gap"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <neth.iecal.curbox.ui.components.AppRowView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/curbox_space_l"
                    app:rowIcon="@drawable/ic_person_round"
                    app:rowIconInCircle="true"
                    app:rowShowChevron="true"
                    app:rowSubtitle="@string/role_user_desc"
                    app:rowTitle="@string/role_user_title" />

                <!-- 16dp padding + 44dp icon + 12dp gap lines this up with the row text. -->
                <LinearLayout
                    android:id="@+id/user_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="72dp"
                    android:paddingEnd="@dimen/curbox_space_l"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle_round"
                        app:tint="@color/curbox_success" />

                    <TextView
                        android:id="@+id/tv_user_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/curbox_success"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
