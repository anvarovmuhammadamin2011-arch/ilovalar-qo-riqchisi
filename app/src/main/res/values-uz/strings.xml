    <string name="protection_state_full_title">Toʻliq boshqariladi</string>
    <string name="protection_state_full_body">Android MBSI bu telefonni boshqarishini tasdiqlaydi. Admin bloklari ishlayapti va admin telefonni boʻshatmaguncha MBSI ni oʻchirib boʻlmaydi.</string>
    <string name="protection_state_standard_title">Oddiy himoya</string>
    <string name="protection_state_standard_body">Admin bloklari ishlayapti. Oddiy telefonda egasi MBSI ni Android sozlamalarida oʻchira oladi. Shunda admin telefonni oflayn deb koʻradi.</string>
    <string name="protection_state_partial_title">Qisman sozlangan</string>
    <string name="protection_state_partial_body">Baʼzi bloklar hali ishlamasligi mumkin. Tuzatish uchun Kerak deb belgilangan bandni bosing.</string>
    <string name="protection_state_off_title">Himoya oʻchiq</string>
    <string name="protection_state_off_body">MBSI xizmati oʻchiq, shuning uchun bloklar ishlamaydi. Uni yoqish uchun pastdagi MBSI xizmati bandini bosing.</string>
    <string name="protection_state_offline_title">Oflayn</string>
    <string name="protection_state_offline_body">Admin serveriga ulanib boʻlmayapti. Oxirgi qoidalaringiz ishlayveradi. Telefon internetga ulanganda yangi oʻzgarishlar keladi.</string>
    <string name="protection_section_permissions">MBSI ga nima kerak</string>
