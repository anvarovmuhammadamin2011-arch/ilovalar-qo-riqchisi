    <string name="protection_release_locked">Juda koʻp notoʻgʻri urinish. %1$d daqiqa kutib qayta urinib koʻring.</string>
    <string name="protection_release_no_code">Admin hali boʻshatish kodini oʻrnatmagan. Undan bu telefonni admin panelda olib tashlashni soʻrang.</string>
    <string name="protection_release_pending">Admin serveri kutilmoqda. Hali hech narsa oʻzgarmadi. Internet yoqilganini tekshirib, qayta urinib koʻring.</string>
    <string name="protection_release_failed">Telefonni boʻshatib boʻlmadi. Qayta urinib koʻring.</string>
    <string name="protection_release_done_title">Bu telefon boʻshatildi</string>
    <string name="protection_release_done_body">Admin endi bu telefonni boshqarmaydi. Admin qoʻygan ilova va sayt bloklari olib tashlandi.</string>
    <string name="protection_release_done_owner">MBSI endi qurilma egasi emas, shuning uchun uni boshqa ilovalar kabi oʻchirishingiz mumkin.</string>
    <string name="protection_section_uninstall">Oʻchirishdan himoya</string>
    <string name="protection_uninstall_button">Admin kodi bilan himoyalash</string>
    <string name="protection_uninstall_explain">MBSI Android dan uni admin olti xonali kodisiz hech kim olib tashlay olmasligini soʻraydi.</string>
