    <string name="protection_item_service">MBSI xizmati</string>
    <string name="protection_item_service_short">Bloklash uchun qaysi ilova ochiqligini koʻradi</string>
    <string name="protection_item_service_long">MBSI ekranda qaysi ilova yoki sayt ochiqligini koʻrish uchun Android Accessibility dan foydalanadi. U bloklangan boʻlsa, MBSI sizni bosh ekranga qaytaradi. MBSI parollaringizni yoki nima yozayotganingizni oʻqimaydi.</string>
    <string name="protection_item_overlay">Blok xabarlari</string>
    <string name="protection_item_overlay_short">Bloklangan ilova ustida xabar koʻrsatadi</string>
    <string name="protection_item_overlay_long">Bu MBSI ga boshqa ilovalar ustida qisqa xabar koʻrsatishga imkon beradi, masalan bloklangan ilova ochilganda.</string>
    <string name="protection_item_usage">Ekran vaqti</string>
    <string name="protection_item_usage_short">Har bir ilovani qancha ishlatganingizni hisoblaydi</string>
    <string name="protection_item_usage_long">MBSI ekran vaqtingizni MBSI xizmati orqali oʻzi hisoblaydi, shuning uchun Android Usage Access kerak emas. U MBSI xizmati yoqilganda ishlaydi.</string>
    <string name="protection_item_sites">Sayt bloklash</string>
    <string name="protection_item_sites_short">Qoʻllab quvvatlanadigan brauzerlarda ishlaydi, VPN siz</string>
    <string name="protection_item_sites_long">MBSI qoʻllab quvvatlanadigan brauzerlarning manzil qatorini MBSI xizmati orqali oʻqiydi. U VPN ishlatmaydi, shuning uchun internet trafigingiz MBSI orqali oʻtmaydi.</string>
    <string name="protection_item_apps">Ilovalar roʻyxati</string>
    <string name="protection_item_apps_short">Adminga qaysi ilovalar oʻrnatilganini koʻrsatadi</string>
    <string name="protection_item_apps_long">MBSI adminga siz ocha oladigan ilovalar nomini yuboradi, toki u nimani bloklashni tanlay olsin. Ilovalar ichida nima qilayotganingizni yubormaydi.</string>
    <string name="protection_item_notifications">Bildirishnomalar</string>
    <string name="protection_item_notifications_short">MBSI ishlayotganini koʻrsatadi</string>
    <string name="protection_item_notifications_long">MBSI ishlayotganda kichik bildirishnoma koʻrsatadi va ogohlantirishlar uchun bildirishnomalardan foydalanadi. Uni oʻchirishingiz mumkin, lekin xabarlarni koʻrmay qolishingiz mumkin.</string>
    <string name="protection_item_battery">Fonda ishlash</string>
    <string name="protection_item_battery_short">MBSI ishlashi va sinxronlanishiga yordam beradi</string>
    <string name="protection_item_battery_long">MBSI uchun batareya tejashni oʻchirish uning ishlashi va sinxronlanishiga yordam beradi. Baʼzi telefonlar baribir ilovalarni vaqti vaqti bilan toʻxtatishi mumkin.</string>
    <string name="protection_item_admin">Admin kompyuteri</string>
    <string name="protection_item_admin_connected">%1$s ga ulangan</string>
    <string name="protection_item_admin_offline">%1$s ga ulanib boʻlmayapti</string>
    <string name="protection_item_admin_checking">%1$s tekshirilmoqda</string>
    <string name="protection_item_admin_long">Qoidalarni admin serveri internet orqali yuboradi. Internet boʻlmasa, oxirgi qoidalaringiz ishlayveradi.</string>
    <string name="protection_mode_standard_title">Oddiy rejim</string>
    <string name="protection_mode_standard_body">Bu oddiy telefon. MBSI admin qoidalariga amal qiladi, lekin Android egasiga MBSI ni oʻchirish yoki olib tashlashga baribir ruxsat beradi.</string>
    <string name="protection_mode_full_title">Toʻliq boshqaruv rejimi</string>
    <string name="protection_mode_full_body">Android MBSI qurilma egasi (device owner) ekanini tasdiqlaydi. Admin bu telefonni boʻshatmaguncha MBSI ni olib tashlab boʻlmaydi.</string>
    <string name="protection_mode_help">Toʻliq boshqaruv rejimi qanday ishlaydi</string>
    <string name="protection_mode_help_body">Toʻliq boshqaruv rejimi maktab yoki oila telefonlari uchun. Uni faqat yangi tozalangan telefonda, hech qanday akkaunt qoʻshilmasdan oldin sozlash mumkin. Katta yoshdagi odam yoki IT mutaxassisi telefonni kompyuterga ulab, quyidagi buyruqni ishga tushiradi:\n\n%1$s\n\nMBSI buni hech qachon oʻzi yoqmaydi.</string>
    <string name="protection_release_body">Bu telefon admin boshqaruvida. Buni toʻxtatish uchun admindan olti xonali kod kerak.</string>
    <string name="protection_release_button">Telefonni boʻshatishni soʻrash</string>
    <string name="protection_release_title">Bu telefonni boʻshatish</string>
    <string name="protection_release_dialog_body">Admindan olgan olti xonali kodni yozing. Uni admin kompyuteri tekshiradi. MBSI kodni bu telefonda hech qachon saqlamaydi.</string>
    <string name="protection_release_hint">Olti xonali kod</string>
    <string name="protection_release_confirm">Boʻshatish</string>
    <string name="protection_release_need_six">Olti ta raqamning hammasini yozing.</string>
